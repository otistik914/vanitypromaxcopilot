# Discord Bot Token (DO NOT SHARE)
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id

# Webhook Security
WEBHOOK_SECRET=generate_long_random_secret_here

# Server Config
PORT=3001
NODE_ENV=production

# PERFORMANCE TUNING - Ultra-Fast Mode (Recommended)
# These defaults are optimized for <50ms latency
CLAIM_INTERVAL_MS=1000
POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=8
QUEUE_MAX_SIZE=1000
DEDUPE_TTL_MS=60000

# Database
DB_PATH=./vanity.db

# Logging
LOG_LEVEL=info

# ============ PERFORMANCE PROFILES ============
# 
# ULTRA-FAST (Default - Minimum Latency)
# CLAIM_INTERVAL_MS=1000
# POLL_INTERVAL_MS=5000
# WORKER_CONCURRENCY=8
# Average Latency: 35-55ms
# Best for: Competitive sniping, speed-focused
#
# FAST (Balanced)
# CLAIM_INTERVAL_MS=2000
# POLL_INTERVAL_MS=8000
# WORKER_CONCURRENCY=6
# Average Latency: 50-100ms
# Best for: Normal usage
#
# STABLE (Conservative)
# CLAIM_INTERVAL_MS=5000
# POLL_INTERVAL_MS=10000
# WORKER_CONCURRENCY=4
# Average Latency: 80-150ms
# Best for: Low resource systems

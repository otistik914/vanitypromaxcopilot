# Discord Bot Token (DO NOT SHARE!)
# Get from: https://discord.com/developers/applications
# Requirements: Bot must be in the target guild with "Manage Guild" permission
DISCORD_TOKEN=your_bot_token_here

# Target Guild ID (where to claim vanity URLs)
# Your server's ID where the bot has admin/manage guild permissions
DISCORD_GUILD_ID=your_server_id_here

# Webhook Security (for receiving vanity change notifications)
# Use a random string of 32+ characters
WEBHOOK_SECRET=generate_a_long_random_secret_minimum_32_characters_here

# Server Configuration
PORT=3001
NODE_ENV=production

# Performance Tuning (Conservative defaults to avoid rate limiting)
WORKER_CONCURRENCY=2
REQUESTS_PER_SECOND=2
POLL_INTERVAL_MS=8000
CLAIM_INTERVAL_MS=5000

# Queue Settings
QUEUE_MAX_SIZE=1000
DEDUPE_TTL_MS=60000

# Database
DB_PATH=./vanity.db

# Logging
LOG_LEVEL=info

# IMPORTANT NOTES:
# 1. Bot must be in DISCORD_GUILD_ID server
# 2. Bot must have "Manage Guild" permission
# 3. DISCORD_TOKEN should be from a bot account
# 4. In production, use environment variables or .env file (not in version control)

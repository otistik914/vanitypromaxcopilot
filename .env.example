# ============================================
# DISCORD BOT CONFIGURATION
# ============================================

# User Account Token (DEĞİŞTİ - BOT TOKEN DEĞİL!)
# NASIL ALINIR?
# 1. Discord'u tarayıcıda aç
# 2. F12 (DevTools) aç
# 3. Network tab'ı aç
# 4. Bir request'e tıkla
# 5. Headers kısmında "Authorization" bul
# 6. Değeri kopyala (genellikle başında "eyJ" ile başlar)
# UYARI: Bu ÇAĞLI private token! Hiç kimseyle paylaşma, public repo'ya commit etme!
DISCORD_USER_TOKEN=your_user_token_here

# Hedef Sunucu ID (vanity claim yapılacak sunucu)
# NASIL?: Discord > Ayarlar > Gelişmiş > Geliştirici Modu > Sunucu adı sağ tıkla > Sunucu ID'sini Kopyala
DISCORD_GUILD_ID=your_server_id_here

# ============================================
# WEBHOOK CONFIGURATION (BAŞARILI/BAŞARISIZ DURUMLAR)
# ============================================

# Discord Webhook URL (bildirim almak için)
# NASIL ALINIR?
# 1. Sunucuda -> #channel sağ tıkla -> Kanal Düzenle
# 2. "İntegrasyonlar" -> "Web hookları"
# 3. "Yeni Web hooku" -> "Oluştur"
# 4. URL'i kopyala
# WEBHOOK NE GÖNDERIRSE:
# ✅ Vanity başarıyla claimed olunca
# ❌ Vanity claim başarısız olunca
# ⏱️ Rate limit takılınca
# ⏳ Network hatası / delay olunca
WEBHOOK_URL=your_webhook_url_here

# Opsiyonel: Webhook Secret (eğer kurulu ise)
WEBHOOK_SECRET=generate_a_long_random_secret_minimum_32_characters_here

# ============================================
# SERVER CONFIGURATION
# ============================================

PORT=3001
NODE_ENV=production

# ============================================
# VANITY CLAIM MODE
# ============================================

# Mode seçimi:
# false = Sunucunun mevcut vanity'sini izle (auto claim)
# true = src/vanity-list.js'den vanity'leri sırası ile claim et (manual)
USE_VANITY_LIST=false

# Vanity listesi modu kullanırken, ne kadar sıklıkla deneme yapsın?
# Sayı ne kadar küçükse o kadar hızlı (ms cinsinden)
# 5000 = 5 saniye arayla, GÜVENLİ
# 3000 = 3 saniye arayla, daha hızlı ama 429 riski
# 8000 = 8 saniye arayla, çok güvenli
VANITY_LIST_INTERVAL_MS=5000

# ============================================
# PERFORMANCE TUNING (Rate Limit İçin ÖNEMLİ)
# ============================================

# Eş zamanlı worker sayısı (kaç tane aynı anda)
# 2 = GÜVENLİ, 429 almama ihtimali yüksek
# 4+ = Daha hızlı ama 429 riski artar
WORKER_CONCURRENCY=2

# Saniyede kaç request atılsın?
# 2 = GÜVENLİ
# 5+ = Daha hızlı ama 429 riski
REQUESTS_PER_SECOND=2

# Sunucunun vanity'sini ne kadar sıklıkla kontrol et? (ms)
# 8000 = 8 saniye, GÜVENLİ
# 5000 = 5 saniye, hızlı
POLL_INTERVAL_MS=8000

# Worker queue'sini ne kadar sıklıkla kontrol et?
CLAIM_INTERVAL_MS=5000

# ============================================
# QUEUE SETTINGS
# ============================================

QUEUE_MAX_SIZE=1000
DEDUPE_TTL_MS=60000

# ============================================
# DATABASE
# ============================================

DB_PATH=./vanity.db

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info

# ============================================
# ÖNEMLİ NOTLAR
# ============================================

# 1. DISCORD_USER_TOKEN kişisel bir token - hiç kimseyle paylaşma!
# 2. .env dosyası ASLA version control'e commit etme (.gitignore'a ekle)
# 3. User token expired olursa yenisini al
# 4. Webhook URL'i set etmezsen, bildirim gelmez
# 5. Vanity listesi boşsa, poller otomatik açılır
#
# HATA ÇÖZÜMLERI:
#
# Eğer "401 Unauthorized" çıkarsa:
#   - User token geçerliliğini yitirmiş
#   - DevTools'dan yeni token al
#
# Eğer "403 Forbidden" çıkarsa:
#   - User sunucuda yönetici olmayabilir
#   - Ya da sunucu kurucusu değilse izin yok
#
# Eğer "Rate limited 429" çıkarsa:
#   - Concurrency düşür (2'ye koy)
#   - REQUESTS_PER_SECOND düşür (1-2'ye koy)
#   - Interval'leri yükselt (8000+ ms)
#
# Eğer webhook mesaj gelmiyor:
#   - WEBHOOK_URL doğru mu kontrol et
#   - Webhook kanalında mesaj yazma izni var mı?

# Discord Bot Token (DO NOT SHARE)
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id

# Webhook Security
WEBHOOK_SECRET=generate_long_random_secret_here

# Server Config
PORT=3001
NODE_ENV=production

# Performance Tuning
CLAIM_INTERVAL_MS=5000
POLL_INTERVAL_MS=8000
WORKER_CONCURRENCY=4
QUEUE_MAX_SIZE=1000
DEDUPE_TTL_MS=60000

# Database
DB_PATH=./vanity.db

# Logging
LOG_LEVEL=info
